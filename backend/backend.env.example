# KEYCLOAK_CLIENT_SECRET below must match the default baked into
# docker/planmate/keycloak/planmate-realm.json
# ("${KEYCLOAK_CLIENT_SECRET:planmate-dev-secret}").

SPRING_PROFILES_ACTIVE=local

DATASOURCE_URL=jdbc:postgresql://localhost:5433/planmate?currentSchema=planmate
DATASOURCE_USER=postgres
DATASOURCE_PASSWORD=postgres

FRONTEND_URL=http://localhost:5173

REDIS_HOST=localhost
REDIS_PORT=6380

JWT_ISSUER_URI=http://localhost:9090/realms/planmate
JWK_SET_URI=http://localhost:9090/realms/planmate/protocol/openid-connect/certs

KEYCLOAK_URL=http://localhost:9090
KEYCLOAK_REALM=planmate
KEYCLOAK_CLIENT_ID=planmate-backend
KEYCLOAK_CLIENT_SECRET=planmate-dev-secret
